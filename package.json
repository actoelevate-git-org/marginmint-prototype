{
  "name": "marginmint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "RUN_DB_TESTS=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run src/repositories/prisma-integration-repository.db.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "docs:diagrams": "node scripts/render-docs-diagrams.mjs",
    "roadmap": "node scripts/roadmap.mjs status",
    "roadmap:start": "node scripts/roadmap.mjs start",
    "roadmap:next": "node scripts/roadmap.mjs next",
    "roadmap:verify": "node scripts/roadmap.mjs verify",
    "roadmap:render": "node scripts/roadmap.mjs render",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.27",
    "prisma": "7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}

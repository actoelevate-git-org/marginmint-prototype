# ---------------------------------------------------------------------------
# MarginMint server configuration. Copy to .env.local for local development.
# Every value is server-only; none is ever sent to the browser.
# Demo pages work with none of these set. Marketplace connections need all of
# the shared values plus the provider's own credentials.
# ---------------------------------------------------------------------------

# --- Shared --------------------------------------------------------------
# Neon pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/marginmint?sslmode=require"
# Neon direct (non-pooled) connection string, used only by `npm run db:migrate`.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/marginmint?sslmode=require"
# Public base URL of this app; OAuth redirect URIs are derived from it:
#   {APP_URL}/api/integrations/amazon/callback
#   {APP_URL}/api/integrations/flipkart/callback
APP_URL="http://localhost:3000"
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts marketplace tokens at rest. Rotating it invalidates stored tokens (sellers must reconnect).
TOKEN_ENCRYPTION_KEY=""

# --- Amazon Selling Partner API (Seller Central > Develop Apps) ----------
AMAZON_SPAPI_APP_ID=""          # amzn1.sp.solution.…
AMAZON_LWA_CLIENT_ID=""         # amzn1.application-oa2-client.…
AMAZON_LWA_CLIENT_SECRET=""
# "true" (default) while the app is in Draft state; adds version=beta to the consent URL.
AMAZON_SPAPI_DRAFT_APP="true"

# --- Flipkart Marketplace Seller API (Seller Hub > Developer Access) -----
FLIPKART_CLIENT_ID=""
FLIPKART_CLIENT_SECRET=""
# Optional: use the sandbox while testing, e.g. https://sandbox-api.flipkart.net
FLIPKART_API_HOST=""

# Future: authentication (Auth.js)
# AUTH_SECRET=""
